{
  "version": 1,
  "_comment": "Read by skill-activation.py on every prompt. keywords: case-insensitive whole words/phrases; intentPatterns: case-insensitive regexes; pathPatterns: regexes matched against file paths named in the prompt or IDE selection. 'with' lists skills always suggested alongside. Skill names must match the Skill tool exactly.",
  "maxSuggestions": 6,
  "wowGate": {
    "_comment": "Every WoW domain hit also suggests these first (CLAUDE.md: wow-client-targets for Forever, then wow-api-index).",
    "with": ["wow-addon-dev:wow-client-targets", "wow-addon-dev:wow-api-index"]
  },
  "skills": {
    "desloppify": {
      "priority": "high",
      "wow": false,
      "keywords": ["desloppify", "tech debt", "technical debt", "health score", "code health scan", "cleanup plan", "strict score"]
    },
    "wow-addon-dev:wow-addon-development": {
      "priority": "medium",
      "note": "repo rules in CLAUDE.md/README.md win over its generic workflow",
      "keywords": ["new module", "new addon", "member addon", "port", "porting", "new feature", "localization", "locale", "recipe book", "pet journal"],
      "intentPatterns": ["\\b(add|create|build|implement|write)\\b.{0,40}\\b(module|feature|addon|option|page|window)\\b"]
    },
    "wow-addon-dev:wow-addon-structure": {
      "priority": "medium",
      "keywords": ["toc", ".toc", "savedvariables", "saved variables", "load order", "loadondemand", "load on demand", "optionaldeps", "dependencies"]
    },
    "wow-addon-dev:wow-api-quests": {
      "priority": "high",
      "keywords": ["quest", "quests", "quest log", "questlog", "objective", "objectives", "tracker", "questie", "questiedb", "quest pins", "world quest", "campaign"],
      "pathPatterns": ["Quest[^/]*\\.lua", "Tracker[^/]*\\.lua"]
    },
    "wow-addon-dev:wow-api-map-navigation": {
      "priority": "high",
      "keywords": ["map", "world map", "worldmap", "minimap", "map pin", "pins", "waypoint", "coordinates", "coords", "nameplate", "nameplates", "vignette", "flight path", "taxi", "zone", "pan", "zoom"],
